<bpmn:callActivity id="Activity_Test1" name="Test Activity">
  <bpmn:incoming>SequenceFlow_0fq51im</bpmn:incoming>
  <bpmn:outgoing>SequenceFlow_New</bpmn:outgoing>
  
  <!-- Documentation -->
  <bpmn:documentation>Primary documentation entry</bpmn:documentation>
  <bpmn:documentation format="text/html">&lt;p&gt;HTML formatted &lt;b&gt;docs&lt;/b&gt;&lt;/p&gt;</bpmn:documentation>
  
  <!-- Loop Characteristics -->
  <bpmn:multiInstanceLoopCharacteristics isSequential="false">
    <bpmn:loopDataInputRef>itemList</bpmn:loopDataInputRef>
  </bpmn:multiInstanceLoopCharacteristics>
  
  <!-- Camunda Extensions -->
  <bpmn:extensionElements>
    <camunda:properties>
        <camunda:property name="priority" value="high" />
        <camunda:property name="retries" value="3" />
    </camunda:properties>
    <camunda:inputOutput>
        <camunda:inputParameter name="inputParam">${inputValue}</camunda:inputParameter>
        <camunda:outputParameter name="outputParam">${result}</camunda:outputParameter>
    </camunda:inputOutput>
</bpmn:extensionElements>
  
  <!-- Resources -->
  <bpmn:resourceRef>Resource_1</bpmn:resourceRef>
  
  <!-- I/O Specification -->
  <bpmn:ioSpecification>
    <bpmn:dataInput id="DataInput_1" name="input1" />
    <bpmn:dataInput id="DataInput_2" name="input2" />
    <bpmn:dataOutput id="DataOutput_1" name="output1" />
    <bpmn:dataOutput id="DataOutput_2" name="output2" />
  </bpmn:ioSpecification>
  
  <!-- Boundary Events -->
  <bpmn:boundaryEvent id="BoundaryEvent_Test1" attachedToRef="Activity_Test1">
    <bpmn:errorEventDefinition errorRef="Error_1" />
  </bpmn:boundaryEvent>
  <bpmn:boundaryEvent id="BoundaryEvent_Test2" attachedToRef="Activity_Test1">
    <bpmn:timerEventDefinition>
      <bpmn:timeDuration>PT1H</bpmn:timeDuration>
    </bpmn:timerEventDefinition>
  </bpmn:boundaryEvent>
</bpmn:callActivity>

