<Window x:Class="BPMNVisualizer.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:vis="clr-namespace:BPMNVisualizer.Visualization"
        mc:Ignorable="d" Title="Simulation History" Height="450" Width="300">
    <Window.Resources>
        <vis:TokenToVisualConverter x:Key="TokenToVisualConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="HistoryList" Grid.Row="0" MouseDoubleClick="HistoryList_MouseDoubleClick" Margin="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontWeight="Bold">
                                    <Run Text="Step "/>
                                    <Run Text="{Binding StepIndex}"/>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <TextBlock Text="{Binding Tokens.Count}" FontWeight="SemiBold"/>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=" Tokens"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tokens.Count}" Value="1">
                                                            <Setter Property="Text" Value=" Token"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=":" Margin="2,0,0,0" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    
                                    <ContentPresenter Content="{Binding Tokens, Converter={StaticResource TokenToVisualConverter}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TriggeredCodeElements}" VerticalAlignment="Center" Margin="10,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="DarkBlue" FontStyle="Italic" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="1" Content="Load State" Click="LoadState_Click" Margin="5" Padding="5"/>
    </Grid>
</Window>