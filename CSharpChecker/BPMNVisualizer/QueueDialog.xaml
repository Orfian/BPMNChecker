<Window x:Class="BPMNVisualizer.QueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message Queue" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" x:Name="HeaderBlock" Text="Select an item to process:" Margin="0,0,0,10" FontWeight="Bold"/>

        <DataGrid Grid.Row="1" x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True" MouseDoubleClick="ItemsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Source Element" Binding="{Binding SourceId}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="TriggerButton" Content="Trigger Without Item" Width="150" Margin="0,0,10,0" Click="TriggerWithoutSelection_Click"/>
            <Button Content="Process Selected" Width="100" Click="ProcessSelected_Click"/>
            <Button Content="Cancel" Width="70" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

