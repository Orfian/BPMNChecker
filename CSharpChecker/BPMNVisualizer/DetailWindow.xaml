<Window x:Class="BPMNVisualizer.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details" Height="500" Width="700" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Note Section -->
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock x:Name="NoteLabel" Text="Note:" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox x:Name="NoteTextBox" Height="40" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>
            <Button Content="Save Note" Click="SaveNote_Click" Padding="5" Margin="0,5,0,5"/>
        </StackPanel>

        <!-- Details Section -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="StandardPanel" Grid.Column="0" Margin="10,0,10,0"/>
                <StackPanel x:Name="CamundaPanel" Grid.Column="1" Margin="10,0,10,0"/>
            </Grid>
        </ScrollViewer>

        <!-- Script Section -->
        <StackPanel x:Name="ScriptPanel" Grid.Row="2" Margin="10" Visibility="Collapsed">
            <TextBlock Text="Script / Code / Expressions:" FontWeight="Bold" Margin="0,5,0,2"/>
            <TextBox x:Name="ScriptTextBox" Height="150" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </StackPanel>
    </Grid>
</Window>
